{
  "manifest_version": 3,
  "name": "UMichScribe: Lecture Transcript Exporter",
  "version": "1.0.0",
  "description": "Exports synchronized lecture transcripts and high-res slides from U-M lecture videos for study and AI review. Unofficial.",
  "browser_specific_settings": {
    "gecko": {
      "id": "umichscribe@hirok",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "activeTab",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.umich.edu/*",
    "https://leccap.engin.umich.edu/*",
    "https://*.kaltura.com/*",
    "https://*.amazonaws.com/*"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "UMichScribe - Export Transcript",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.umich.edu/*",
        "https://leccap.engin.umich.edu/*",
        "https://*.kaltura.com/*"
      ],
      "js": ["content/index.js"],
      "all_frames": true
    }
  ]
}
